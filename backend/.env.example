    # Server Configuration
PROJECT_NAME="Meeting Summarizer API"
API_V1_STR="/api/v1"
UPLOAD_DIR="./uploads"

# Database & Vector Store
DATABASE_URL="sqlite:///./meetings.db"
CHROMA_PERSIST_DIR="./chroma_db"

# LLM Configuration (options: 'gemini' or 'ollama')
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# Ollama Configuration (offline fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"

# ASR Configuration (whisper model size: tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu" # or "cuda" if GPU is available